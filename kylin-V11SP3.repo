### Kylin Linux Advanced Server 11 - 2503 ###

[v11-adv-os]
name = Kylin Linux Advanced Server 11 - Os
baseurl = https://update.cs2c.com.cn/NS/V11/2503/os/adv/lic/base/$basearch/
gpgcheck = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-kylin
enabled = 1

[v11-adv-updates]
name = Kylin Linux Advanced Server 11 - Updates
baseurl = https://update.cs2c.com.cn/NS/V11/2503/os/adv/lic/updates/$basearch/
gpgcheck = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-kylin
enabled = 1

# No add-ons repository is required for the base image.
[v11-adv-addons]
name = Kylin Linux Advanced Server 11 - Addons
baseurl = https://update.cs2c.com.cn/NS/V11/2503/os/adv/lic/addons/$basearch/
gpgcheck = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-kylin
enabled = 0
